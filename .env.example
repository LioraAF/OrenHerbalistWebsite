# Set these in Vercel Project > Settings > Environment Variables.
# Never put secret keys in HTML or browser JavaScript.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@orenherbalist.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional, comma-separated exact origins for trusted preview/local deployments.
# Production orenherbalist.com and www.orenherbalist.com are already allowed.
CONTACT_ALLOWED_ORIGINS=
